# Copy to backend/.env and fill in real values there. Never commit backend/.env.
#
# Supabase: Project Settings -> Database -> connection string -> URI.
# Use the direct Postgres connection (the database owner). Do not put the
# anon key or the service_role key in the dashboard or in this file.
# Railway gets the same variables later. Use two different tokens.
DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres
DEVICE_API_TOKEN=replace-with-a-long-device-token
DASHBOARD_API_TOKEN=replace-with-a-different-dashboard-token
# Comma-separated browser origins. The React dev server is the default.
CORS_ORIGINS=http://localhost:5173
# Railway sets PORT itself. Locally the process listens on 8001.
PORT=8001
